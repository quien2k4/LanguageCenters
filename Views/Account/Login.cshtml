@model LanguageCenter.Controllers.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <h2 class="mb-4">Đăng nhập</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(model => model.Email, "Email", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", autocomplete = "email", required = "required" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Password, "Mật khẩu", new { @class = "form-label" })
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "current-password", required = "required" })
            </div>

            <div class="form-check mb-3">
                @Html.CheckBoxFor(model => model.RememberMe, new { @class = "form-check-input" })
                @Html.LabelFor(model => model.RememberMe, "Ghi nhớ đăng nhập", new { @class = "form-check-label" })
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
        }

        <div class="mt-3">
            @Html.ActionLink("Tạo tài khoản học viên", "Register", "Account")
        </div>
    </div>
</div>
