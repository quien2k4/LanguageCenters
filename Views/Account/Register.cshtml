@model LanguageCenter.Controllers.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6">
        <h2 class="mb-4">Đăng ký học viên</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                @Html.LabelFor(model => model.FullName, "Họ tên", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", autocomplete = "name", required = "required" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Email, "Email", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", autocomplete = "email", required = "required" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Password, "Mật khẩu", new { @class = "form-label" })
                @Html.PasswordFor(model => model.Password, new { @class = "form-control", autocomplete = "new-password", required = "required" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label" })
                @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", required = "required" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.PhoneNumber, "Số điện thoại", new { @class = "form-label" })
                @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", type = "tel", autocomplete = "tel", required = "required" })
            </div>

            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>
        }

        <div class="mt-3">
            @Html.ActionLink("Đã có tài khoản? Đăng nhập", "Login", "Account")
        </div>
    </div>
</div>
