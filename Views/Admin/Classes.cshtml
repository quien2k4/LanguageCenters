@model LanguageCenter.Models.AdminClassPageViewModel

@{
    ViewBag.Title = "Quản lý lớp học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="admin-page-header mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý lớp học</h2>
            <p class="text-muted mb-0">Thêm, cập nhật và thay đổi trạng thái lớp học.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Classes", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-lg-2 col-md-6">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Lớp hoặc chương trình" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="programId" class="form-label">Chương trình</label>
                    @Html.DropDownList("programId", Model.Programs, "Tất cả chương trình", new { @class = "form-select" })
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="teacherId" class="form-label">Giáo viên</label>
                    @Html.DropDownList("teacherId", Model.Teachers, "Tất cả giáo viên", new { @class = "form-select" })
                </div>
                <div class="col-lg-2 col-md-6">
                    <label for="statusId" class="form-label">Trạng thái</label>
                    @Html.DropDownList("statusId", Model.Statuses, "Tất cả trạng thái", new { @class = "form-select" })
                </div>
                <div class="col-lg-2 col-md-12">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <a href="@Url.Action("Classes", "Admin")" class="btn btn-outline-secondary">Đặt lại</a>
                        <a href="@Url.Action("CreateClass", "Admin")" class="btn btn-success">Thêm mới</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã lớp</th>
                                <th>Tên lớp</th>
                                <th>Chương trình</th>
                                <th>Giáo viên</th>
                                <th>Trạng thái</th>
                                <th>Ngày bắt đầu</th>
                                <th>Lịch học</th>
                                <th>Phòng</th>
                                <th>Học viên</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Classes)
                            {
                                <tr>
                                    <td>@item.ClassID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Đang cập nhật" : item.ProgramName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.TeacherName) ? "Đang cập nhật" : item.TeacherName)</td>
                                    <td><span class="badge bg-secondary">@LanguageCenter.Models.DisplayText.Status(item.StatusName)</span></td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</td>
                                    <td class="text-wrap-cell" style="white-space: pre-line;">@item.Schedule</td>
                                    <td>@item.Room</td>
                                    <td>@item.StudentCount</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("EditClass", "Admin", new { id = item.ClassID })" class="btn btn-sm btn-outline-primary">Sửa</a>
                                            <a href="@Url.Action("DeleteClass", "Admin", new { id = item.ClassID })" class="btn btn-sm btn-outline-danger">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang lớp học">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Classes", "Admin", new { search = Model.Search, programId = Model.ProgramID, teacherId = Model.TeacherID, statusId = Model.StatusID, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Classes", "Admin", new { search = Model.Search, programId = Model.ProgramID, teacherId = Model.TeacherID, statusId = Model.StatusID, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Classes", "Admin", new { search = Model.Search, programId = Model.ProgramID, teacherId = Model.TeacherID, statusId = Model.StatusID, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Không tìm thấy lớp học.</div>
                </div>
            }
        </div>
    </div>
</div>
