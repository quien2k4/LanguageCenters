@model LanguageCenter.Models.AdminClassPageViewModel

@{
    ViewBag.Title = "Manage Classes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Manage Classes</h2>
            <p class="text-muted mb-0">Create, update, and change class status.</p>
        </div>
        <a href="@Url.Action("CreateClass", "Admin")" class="btn btn-primary">Create Class</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Classes", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-3">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Class or program" />
                </div>
                <div class="col-md-3">
                    <label for="programId" class="form-label">Program</label>
                    @Html.DropDownList("programId", Model.Programs, "All programs", new { @class = "form-select" })
                </div>
                <div class="col-md-3">
                    <label for="teacherId" class="form-label">Teacher</label>
                    @Html.DropDownList("teacherId", Model.Teachers, "All teachers", new { @class = "form-select" })
                </div>
                <div class="col-md-2">
                    <label for="statusId" class="form-label">Status</label>
                    @Html.DropDownList("statusId", Model.Statuses, "All statuses", new { @class = "form-select" })
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">Go</button>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Class ID</th>
                                <th>Class Name</th>
                                <th>Program</th>
                                <th>Teacher</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>Schedule</th>
                                <th>Room</th>
                                <th>Students</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Classes)
                            {
                                <tr>
                                    <td>@item.ClassID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Updating" : item.ProgramName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.TeacherName) ? "Updating" : item.TeacherName)</td>
                                    <td><span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.StatusName) ? "Updating" : item.StatusName)</span></td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                                    <td style="min-width: 220px; white-space: pre-line;">@item.Schedule</td>
                                    <td>@item.Room</td>
                                    <td>@item.StudentCount</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("EditClass", "Admin", new { id = item.ClassID })" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <a href="@Url.Action("DeleteClass", "Admin", new { id = item.ClassID })" class="btn btn-sm btn-outline-danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Class pagination">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Classes", "Admin", new { search = Model.Search, programId = Model.ProgramID, teacherId = Model.TeacherID, statusId = Model.StatusID, page = Model.CurrentPage - 1 })">Previous</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Classes", "Admin", new { search = Model.Search, programId = Model.ProgramID, teacherId = Model.TeacherID, statusId = Model.StatusID, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Classes", "Admin", new { search = Model.Search, programId = Model.ProgramID, teacherId = Model.TeacherID, statusId = Model.StatusID, page = Model.CurrentPage + 1 })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No classes found.</div>
                </div>
            }
        </div>
    </div>
</div>
