@model LanguageCenter.Models.AdminConsultationPageViewModel

@{
    ViewBag.Title = "Quản lý tư vấn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Quản lý tư vấn</h2>
        <p class="text-muted mb-0">Xem yêu cầu tư vấn và cập nhật trạng thái xử lý.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Tổng yêu cầu tư vấn</div>
                    <h4 class="mb-0">@Model.TotalConsultations</h4>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Chờ xử lý</div>
                    <h4 class="mb-0">@Model.PendingConsultations</h4>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Đang xử lý</div>
                    <h4 class="mb-0">@Model.ProcessingConsultations</h4>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Hoàn thành</div>
                    <h4 class="mb-0">@Model.CompletedConsultations</h4>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Đã hủy</div>
                    <h4 class="mb-0">@Model.CancelledConsultations</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Consultations", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-md-7">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tên khách, liên hệ, nội dung câu hỏi" />
                </div>
                <div class="col-md-3">
                    <label for="status" class="form-label">Trạng thái yêu cầu</label>
                    <select id="status" name="status" class="form-select">
                        <option value="All" @(Model.Status == "All" ? "selected" : "")>Tất cả</option>
                        <option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Chờ xử lý</option>
                        <option value="Processing" @(Model.Status == "Processing" ? "selected" : "")>Đang xử lý</option>
                        <option value="Completed" @(Model.Status == "Completed" ? "selected" : "")>Hoàn thành</option>
                        <option value="Cancelled" @(Model.Status == "Cancelled" ? "selected" : "")>Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <a href="@Url.Action("Consultations", "Admin")" class="btn btn-outline-secondary">Đặt lại</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Consultations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã tư vấn</th>
                                <th>Tên khách</th>
                                <th>Liên hệ</th>
                                <th>Nội dung câu hỏi</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Consultations)
                            {
                                <tr>
                                    <td>@item.ConsultationID</td>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.GuestName) ? "Đang cập nhật" : item.GuestName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ContactInformation) ? "Đang cập nhật" : item.ContactInformation)</td>
                                    <td class="text-wrap-cell">@(string.IsNullOrWhiteSpace(item.QuestionContent) ? "Chưa có câu hỏi" : item.QuestionContent)</td>
                                    <td>
                                        <span class="badge @(item.RequestStatus == "Completed" ? "bg-success" : item.RequestStatus == "Cancelled" ? "bg-danger" : item.RequestStatus == "Processing" ? "bg-info" : "bg-warning text-dark")">
                                            @LanguageCenter.Models.DisplayText.Status(item.RequestStatus)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("EditConsultation", "Admin", new { id = item.ConsultationID })" class="btn btn-sm btn-outline-primary">Sửa trạng thái</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang tư vấn">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Consultations", "Admin", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Consultations", "Admin", new { search = Model.Search, status = Model.Status, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Consultations", "Admin", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Không tìm thấy yêu cầu tư vấn.</div>
                </div>
            }
        </div>
    </div>
</div>
