@model LanguageCenter.Models.AdminClassViewModel

@{
    ViewBag.Title = "Đổi trạng thái lớp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Đổi trạng thái lớp</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        Thao tác này sẽ không xóa lớp. Hệ thống chỉ đổi trạng thái lớp sang đã hủy hoặc đã đóng.
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Lớp</div>
                                <div class="fw-semibold">@Model.ClassName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Chương trình</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Đang cập nhật" : Model.ProgramName)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Giáo viên</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.TeacherName) ? "Đang cập nhật" : Model.TeacherName)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Trạng thái hiện tại</div>
                                <div class="fw-semibold">@LanguageCenter.Models.DisplayText.Status(Model.StatusName)</div>
                            </div>
                        </div>
                    </div>

                    @using (Html.BeginForm("ConfirmDeleteClass", "Admin", new { id = Model.ClassID }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Đổi trạng thái</button>
                            <a href="@Url.Action("Classes", "Admin")" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
