@model LanguageCenter.Models.AdminProgramViewModel

@{
    ViewBag.Title = "Ngừng hoạt động chương trình";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageURL)
        ? Url.Content("~/Content/Images/default-program.jpg")
        : Url.Content(Model.ImageURL);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Ngừng hoạt động chương trình</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        Thao tác này sẽ chuyển chương trình sang trạng thái ngừng hoạt động. Dữ liệu sẽ không bị xóa khỏi database.
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <img src="@imageUrl" alt="@Model.ProgramName" class="rounded border" style="width: 140px; height: 96px; object-fit: cover;" />
                        <div>
                            <h5 class="fw-bold mb-1">@Model.ProgramName</h5>
                            <div class="text-muted">Trình độ: @(string.IsNullOrWhiteSpace(Model.Level) ? "Đang cập nhật" : Model.Level)</div>
                            <div class="text-muted">Thời lượng: @(string.IsNullOrWhiteSpace(Model.Duration) ? "Đang cập nhật" : Model.Duration)</div>
                            <div class="text-muted">Học phí: @Model.Fee.ToString("N0")</div>
                        </div>
                    </div>

                    @using (Html.BeginForm("ConfirmDeleteProgram", "Admin", new { id = Model.ProgramID }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Ngừng hoạt động</button>
                            <a href="@Url.Action("Programs", "Admin")" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
