@model LanguageCenter.Models.AdminStudentViewModel

@{
    ViewBag.Title = "Ngừng hoạt động học viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var avatar = string.IsNullOrWhiteSpace(Model.Avatar)
        ? Url.Content("~/Content/Images/default-avatar.png")
        : Url.Content(Model.Avatar);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Ngừng hoạt động học viên</h4>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="@avatar" alt="@Model.FullName" class="rounded-circle" style="width: 72px; height: 72px; object-fit: cover;" />
                        <div>
                            <h5 class="mb-1">@Model.FullName</h5>
                            <div class="text-muted">@Model.Email</div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        Thao tác này chỉ chuyển tài khoản học viên sang ngừng hoạt động. Đăng ký, thanh toán và bài kiểm tra đầu vào sẽ không bị xóa.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Mã học viên</dt>
                        <dd class="col-sm-8">@Model.StudentID</dd>

                        <dt class="col-sm-4">Số điện thoại</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Đăng ký</dt>
                        <dd class="col-sm-8">@Model.RegistrationCount</dd>

                        <dt class="col-sm-4">Thanh toán</dt>
                        <dd class="col-sm-8">@Model.PaymentCount</dd>

                        <dt class="col-sm-4">Kiểm tra đầu vào</dt>
                        <dd class="col-sm-8">@Model.PlacementTestCount</dd>
                    </dl>

                    @using (Html.BeginForm("ConfirmDeleteStudent", "Admin", new { id = Model.StudentID }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Ngừng hoạt động</button>
                            <a href="@Url.Action("Students", "Admin")" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
