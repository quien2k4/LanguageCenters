@model LanguageCenter.Models.AdminTeacherViewModel

@{
    ViewBag.Title = "Ngừng hoạt động giáo viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var avatar = string.IsNullOrWhiteSpace(Model.Avatar)
        ? Url.Content("~/Content/Images/default-avatar.png")
        : Url.Content(Model.Avatar);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Ngừng hoạt động giáo viên</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        Thao tác này sẽ chuyển tài khoản giáo viên sang ngừng hoạt động. Các lớp hiện có sẽ không bị xóa.
                    </div>

                    <div class="d-flex gap-3 mb-4">
                        <img src="@avatar" alt="@Model.FullName" class="rounded-circle border" style="width: 96px; height: 96px; object-fit: cover;" />
                        <div>
                            <h5 class="fw-bold mb-1">@Model.FullName</h5>
                            <div class="text-muted">@Model.Email</div>
                            <div class="text-muted">Chuyên môn: @(string.IsNullOrWhiteSpace(Model.Expertise) ? "Đang cập nhật" : Model.Expertise)</div>
                            <div class="text-muted">Lớp học: @Model.ClassCount</div>
                        </div>
                    </div>

                    @using (Html.BeginForm("ConfirmDeleteTeacher", "Admin", new { id = Model.TeacherID }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Ngừng hoạt động</button>
                            <a href="@Url.Action("Teachers", "Admin")" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
