@model LanguageCenter.Models.AdminConsultationFormViewModel

@{
    ViewBag.Title = "Sửa trạng thái tư vấn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Sửa trạng thái tư vấn</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Mã tư vấn</dt>
                        <dd class="col-sm-8">@Model.ConsultationID</dd>

                        <dt class="col-sm-4">Tên khách</dt>
                        <dd class="col-sm-8">@Model.GuestName</dd>

                        <dt class="col-sm-4">Liên hệ</dt>
                        <dd class="col-sm-8">@Model.ContactInformation</dd>

                        <dt class="col-sm-4">Câu hỏi</dt>
                        <dd class="col-sm-8">@Model.QuestionContent</dd>

                        <dt class="col-sm-4">Trạng thái hiện tại</dt>
                        <dd class="col-sm-8">@LanguageCenter.Models.DisplayText.Status(Model.RequestStatus)</dd>
                    </dl>

                    @using (Html.BeginForm("EditConsultation", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ConsultationID)

                        <div class="mb-3">
                            @Html.LabelFor(model => model.RequestStatus, new { @class = "form-label" })
                            <select id="RequestStatus" name="RequestStatus" class="form-select">
                                <option value="Pending" @(Model.RequestStatus == "Pending" ? "selected" : "")>Chờ xử lý</option>
                                <option value="Processing" @(Model.RequestStatus == "Processing" ? "selected" : "")>Đang xử lý</option>
                                <option value="Completed" @(Model.RequestStatus == "Completed" ? "selected" : "")>Hoàn thành</option>
                                <option value="Cancelled" @(Model.RequestStatus == "Cancelled" ? "selected" : "")>Đã hủy</option>
                            </select>
                            @Html.ValidationMessageFor(model => model.RequestStatus, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                            <a href="@Url.Action("Consultations", "Admin")" class="btn btn-outline-secondary">Quay lại tư vấn</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
