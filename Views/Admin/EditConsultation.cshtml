@model LanguageCenter.Models.AdminConsultationFormViewModel

@{
    ViewBag.Title = "Edit Consultation Status";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Consultation Status</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Consultation ID</dt>
                        <dd class="col-sm-8">@Model.ConsultationID</dd>

                        <dt class="col-sm-4">Guest Name</dt>
                        <dd class="col-sm-8">@Model.GuestName</dd>

                        <dt class="col-sm-4">Contact</dt>
                        <dd class="col-sm-8">@Model.ContactInformation</dd>

                        <dt class="col-sm-4">Question</dt>
                        <dd class="col-sm-8">@Model.QuestionContent</dd>

                        <dt class="col-sm-4">Current Status</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.RequestStatus) ? "Updating" : Model.RequestStatus)</dd>
                    </dl>

                    @using (Html.BeginForm("EditConsultation", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ConsultationID)

                        <div class="mb-3">
                            @Html.LabelFor(model => model.RequestStatus, new { @class = "form-label" })
                            <select id="RequestStatus" name="RequestStatus" class="form-select">
                                <option value="Pending" @(Model.RequestStatus == "Pending" ? "selected" : "")>Pending</option>
                                <option value="Processing" @(Model.RequestStatus == "Processing" ? "selected" : "")>Processing</option>
                                <option value="Completed" @(Model.RequestStatus == "Completed" ? "selected" : "")>Completed</option>
                                <option value="Cancelled" @(Model.RequestStatus == "Cancelled" ? "selected" : "")>Cancelled</option>
                            </select>
                            @Html.ValidationMessageFor(model => model.RequestStatus, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="@Url.Action("Consultations", "Admin")" class="btn btn-outline-secondary">Back to Consultations</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
