@model LanguageCenter.Models.AdminPaymentFormViewModel

@{
    ViewBag.Title = "Edit Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Payment</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Payment ID</dt>
                        <dd class="col-sm-8">@Model.PaymentID</dd>

                        <dt class="col-sm-4">Registration ID</dt>
                        <dd class="col-sm-8">@Model.RegistrationID</dd>

                        <dt class="col-sm-4">Student</dt>
                        <dd class="col-sm-8">@Model.StudentName</dd>

                        <dt class="col-sm-4">Class</dt>
                        <dd class="col-sm-8">@Model.ClassName</dd>

                        <dt class="col-sm-4">Program</dt>
                        <dd class="col-sm-8">@Model.ProgramName</dd>

                        <dt class="col-sm-4">Payment Date</dt>
                        <dd class="col-sm-8">@(Model.PaymentDate.HasValue ? Model.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm") : "Not paid yet")</dd>
                    </dl>

                    @using (Html.BeginForm("EditPayment", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.PaymentID)

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Amount, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.Amount, new { @class = "form-control", type = "number", min = "0", step = "1000" })
                            @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.Method, new { @class = "form-label" })
                            <select id="Method" name="Method" class="form-select">
                                <option value="">Select method</option>
                                <option value="Demo" @(Model.Method == "Demo" ? "selected" : "")>Demo</option>
                                <option value="Cash" @(Model.Method == "Cash" ? "selected" : "")>Cash</option>
                                <option value="Bank Transfer" @(Model.Method == "Bank Transfer" ? "selected" : "")>Bank Transfer</option>
                                <option value="Online" @(Model.Method == "Online" ? "selected" : "")>Online</option>
                            </select>
                            @Html.ValidationMessageFor(model => model.Method, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.PaymentStatus, new { @class = "form-label" })
                            <select id="PaymentStatus" name="PaymentStatus" class="form-select">
                                <option value="Unpaid" @(Model.PaymentStatus == "Unpaid" ? "selected" : "")>Unpaid</option>
                                <option value="Paid" @(Model.PaymentStatus == "Paid" ? "selected" : "")>Paid</option>
                                <option value="Failed" @(Model.PaymentStatus == "Failed" ? "selected" : "")>Failed</option>
                                <option value="Refunded" @(Model.PaymentStatus == "Refunded" ? "selected" : "")>Refunded</option>
                            </select>
                            @Html.ValidationMessageFor(model => model.PaymentStatus, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="@Url.Action("Payments", "Admin")" class="btn btn-outline-secondary">Back to Payments</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
