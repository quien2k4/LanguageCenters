@model LanguageCenter.Models.AdminStudentFormViewModel

@{
    ViewBag.Title = "Sửa học viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var avatar = string.IsNullOrWhiteSpace(Model.Avatar)
        ? Url.Content("~/Content/Images/default-avatar.png")
        : Url.Content(Model.Avatar);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Sửa học viên</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    @using (Html.BeginForm("EditStudent", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.StudentID)
                        @Html.HiddenFor(model => model.AccountID)
                        @Html.HiddenFor(model => model.Avatar)

                        <div class="mb-3">
                            <img src="@avatar" alt="@Model.FullName" class="rounded-circle" style="width: 72px; height: 72px; object-fit: cover;" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.Email, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "email", required = "required" })
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.FullName, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.DateOfBirth, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.PhoneNumber, new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-8">
                                <label for="avatarFile" class="form-label">Tải ảnh đại diện mới</label>
                                <input type="file" id="avatarFile" name="avatarFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                                    @Html.LabelFor(model => model.IsActive, new { @class = "form-check-label" })
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="border rounded p-3 h-100">
                                    <div class="text-muted small">Trạng thái khóa</div>
                                    <div class="fw-semibold">@(Model.IsLockedOut ? "Đang bị khóa" : "Không bị khóa")</div>
                                    <div class="text-muted small">Số lần đăng nhập sai: @Model.FailedLoginAttempts</div>
                                </div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check mb-2">
                                    @Html.CheckBoxFor(model => model.UnlockAccount, new { @class = "form-check-input" })
                                    @Html.LabelFor(model => model.UnlockAccount, new { @class = "form-check-label" })
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                            <a href="@Url.Action("Students", "Admin")" class="btn btn-outline-secondary">Quay lại học viên</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

