@model LanguageCenter.Models.AdminPaymentPageViewModel

@{
    ViewBag.Title = "Quản lý thanh toán";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Quản lý thanh toán</h2>
        <p class="text-muted mb-0">Xem và cập nhật hồ sơ thanh toán của học viên.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Tổng thanh toán</div>
                    <h4 class="mb-0">@Model.TotalPayments</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Đã thanh toán</div>
                    <h4 class="mb-0">@Model.PaidPayments</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Chưa thanh toán</div>
                    <h4 class="mb-0">@Model.UnpaidPayments</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Tổng doanh thu</div>
                    <h4 class="mb-0">@Model.TotalRevenue.ToString("N0")</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Payments", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-lg-4 col-md-6">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Học viên, email, lớp, chương trình" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="paymentStatus" class="form-label">Trạng thái thanh toán</label>
                    <select id="paymentStatus" name="paymentStatus" class="form-select">
                        <option value="All" @(Model.PaymentStatus == "All" ? "selected" : "")>Tất cả</option>
                        <option value="Unpaid" @(Model.PaymentStatus == "Unpaid" ? "selected" : "")>Chưa thanh toán</option>
                        <option value="Paid" @(Model.PaymentStatus == "Paid" ? "selected" : "")>Đã thanh toán</option>
                        <option value="Failed" @(Model.PaymentStatus == "Failed" ? "selected" : "")>Thất bại</option>
                        <option value="Refunded" @(Model.PaymentStatus == "Refunded" ? "selected" : "")>Đã hoàn tiền</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="method" class="form-label">Phương thức</label>
                    <select id="method" name="method" class="form-select">
                        <option value="All" @(Model.Method == "All" ? "selected" : "")>Tất cả</option>
                        <option value="Demo" @(Model.Method == "Demo" ? "selected" : "")>Demo</option>
                        <option value="Cash" @(Model.Method == "Cash" ? "selected" : "")>Tiền mặt</option>
                        <option value="Bank Transfer" @(Model.Method == "Bank Transfer" ? "selected" : "")>Chuyển khoản</option>
                        <option value="Online" @(Model.Method == "Online" ? "selected" : "")>Online</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <a href="@Url.Action("Payments", "Admin")" class="btn btn-outline-secondary">Đặt lại</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Payments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã thanh toán</th>
                                <th>Mã đăng ký</th>
                                <th>Học viên</th>
                                <th>Email</th>
                                <th>Lớp</th>
                                <th>Chương trình</th>
                                <th>Số tiền</th>
                                <th>Ngày thanh toán</th>
                                <th>Phương thức</th>
                                <th>Trạng thái thanh toán</th>
                                <th>Trạng thái đăng ký</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Payments)
                            {
                                <tr>
                                    <td>@item.PaymentID</td>
                                    <td>@item.RegistrationID</td>
                                    <td class="fw-semibold">@item.StudentName</td>
                                    <td>@item.StudentEmail</td>
                                    <td>@item.ClassName</td>
                                    <td class="text-wrap-cell">@item.ProgramName</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa thanh toán")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Method) ? "-" : item.Method)</td>
                                    <td>
                                        <span class="badge @(item.PaymentStatus == "Paid" ? "bg-success" : item.PaymentStatus == "Unpaid" ? "bg-warning text-dark" : item.PaymentStatus == "Failed" ? "bg-danger" : "bg-info")">
                                            @LanguageCenter.Models.DisplayText.Status(item.PaymentStatus)
                                        </span>
                                    </td>
                                    <td>@LanguageCenter.Models.DisplayText.Status(item.RegStatus)</td>
                                    <td class="text-end">
                                        <a href="@Url.Action("EditPayment", "Admin", new { id = item.PaymentID })" class="btn btn-sm btn-outline-primary">Sửa thanh toán</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang thanh toán">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Payments", "Admin", new { search = Model.Search, paymentStatus = Model.PaymentStatus, method = Model.Method, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Payments", "Admin", new { search = Model.Search, paymentStatus = Model.PaymentStatus, method = Model.Method, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Payments", "Admin", new { search = Model.Search, paymentStatus = Model.PaymentStatus, method = Model.Method, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Không tìm thấy thanh toán.</div>
                </div>
            }
        </div>
    </div>
</div>
