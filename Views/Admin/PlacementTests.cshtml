@model LanguageCenter.Models.AdminPlacementTestPageViewModel

@{
    ViewBag.Title = "Manage Placement Tests";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Manage Placement Tests</h2>
        <p class="text-muted mb-0">Review placement test schedules and update results.</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Total Tests</div>
                    <h4 class="mb-0">@Model.TotalTests</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Pending Tests</div>
                    <h4 class="mb-0">@Model.PendingTests</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Completed Tests</div>
                    <h4 class="mb-0">@Model.CompletedTests</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Cancelled Tests</div>
                    <h4 class="mb-0">@Model.CancelledTests</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("PlacementTests", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-lg-4 col-md-6">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Student, email, phone, level" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="All" @(Model.Status == "All" ? "selected" : "")>All</option>
                        <option value="Pending" @(Model.Status == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Completed" @(Model.Status == "Completed" ? "selected" : "")>Completed</option>
                        <option value="Cancelled" @(Model.Status == "Cancelled" ? "selected" : "")>Cancelled</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="level" class="form-label">Level</label>
                    <select id="level" name="level" class="form-select">
                        <option value="">All</option>
                        @foreach (var item in Model.Levels)
                        {
                            <option value="@item" @(Model.Level == item ? "selected" : "")>@item</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Search</button>
                        <a href="@Url.Action("PlacementTests", "Admin")" class="btn btn-outline-secondary">Reset</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.PlacementTests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Test ID</th>
                                <th>Student</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Test Date</th>
                                <th>Test Time</th>
                                <th>Level</th>
                                <th>Result Score</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PlacementTests)
                            {
                                <tr>
                                    <td>@item.TestID</td>
                                    <td class="fw-semibold">@item.StudentName</td>
                                    <td>@item.StudentEmail</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "Updating" : item.PhoneNumber)</td>
                                    <td>@item.TestDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.TestTime.ToString(@"hh\:mm")</td>
                                    <td>@item.Level</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ResultScore) ? "Not updated yet" : item.ResultScore)</td>
                                    <td>
                                        <span class="badge @(item.Status == "Completed" ? "bg-success" : item.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                            @(string.IsNullOrWhiteSpace(item.Status) ? "Updating" : item.Status)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("EditPlacementTest", "Admin", new { id = item.TestID })" class="btn btn-sm btn-outline-primary">Edit Result</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Placement test pagination">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("PlacementTests", "Admin", new { search = Model.Search, status = Model.Status, level = Model.Level, page = Model.CurrentPage - 1 })">Previous</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("PlacementTests", "Admin", new { search = Model.Search, status = Model.Status, level = Model.Level, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("PlacementTests", "Admin", new { search = Model.Search, status = Model.Status, level = Model.Level, page = Model.CurrentPage + 1 })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No placement tests found.</div>
                </div>
            }
        </div>
    </div>
</div>
