@model LanguageCenter.Models.AdminRegistrationPageViewModel

@{
    ViewBag.Title = "Quản lý đăng ký";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý đăng ký</h2>
            <p class="text-muted mb-0">Xem đăng ký của học viên và cập nhật trạng thái đăng ký.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Registrations", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-lg-4 col-md-6">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Học viên, email, lớp, chương trình" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="regStatus" class="form-label">Trạng thái đăng ký</label>
                    <select id="regStatus" name="regStatus" class="form-select">
                        <option value="All" @(Model.RegStatus == "All" ? "selected" : "")>Tất cả</option>
                        <option value="Pending" @(Model.RegStatus == "Pending" ? "selected" : "")>Chờ xử lý</option>
                        <option value="Approved" @(Model.RegStatus == "Approved" ? "selected" : "")>Đã duyệt</option>
                        <option value="Cancelled" @(Model.RegStatus == "Cancelled" ? "selected" : "")>Đã hủy</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="paymentStatus" class="form-label">Trạng thái thanh toán</label>
                    <select id="paymentStatus" name="paymentStatus" class="form-select">
                        <option value="All" @(Model.PaymentStatus == "All" ? "selected" : "")>Tất cả</option>
                        <option value="Unpaid" @(Model.PaymentStatus == "Unpaid" ? "selected" : "")>Chưa thanh toán</option>
                        <option value="Paid" @(Model.PaymentStatus == "Paid" ? "selected" : "")>Đã thanh toán</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <a href="@Url.Action("Registrations", "Admin")" class="btn btn-outline-secondary">Đặt lại</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Registrations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đăng ký</th>
                                <th>Học viên</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Lớp</th>
                                <th>Chương trình</th>
                                <th>Giáo viên</th>
                                <th>Ngày đăng ký</th>
                                <th>Trạng thái đăng ký</th>
                                <th>Thanh toán</th>
                                <th>Số tiền</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Registrations)
                            {
                                <tr>
                                    <td>@item.RegistrationID</td>
                                    <td class="fw-semibold">@item.StudentName</td>
                                    <td>@item.StudentEmail</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "Đang cập nhật" : item.PhoneNumber)</td>
                                    <td>@item.ClassName</td>
                                    <td class="text-wrap-cell">@item.ProgramName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.TeacherName) ? "Đang cập nhật" : item.TeacherName)</td>
                                    <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")</td>
                                    <td>
                                        <span class="badge @(item.RegStatus == "Approved" ? "bg-success" : item.RegStatus == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                            @LanguageCenter.Models.DisplayText.Status(item.RegStatus)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.PaymentStatus == "Paid" ? "bg-success" : item.PaymentStatus == "Unpaid" ? "bg-warning text-dark" : "bg-secondary")">
                                            @LanguageCenter.Models.DisplayText.Status(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "No payment" : item.PaymentStatus)
                                        </span>
                                    </td>
                                    <td>@(item.Amount.HasValue ? item.Amount.Value.ToString("N0") : "-")</td>
                                    <td class="text-end">
                                        <a href="@Url.Action("EditRegistration", "Admin", new { id = item.RegistrationID })" class="btn btn-sm btn-outline-primary">Sửa trạng thái</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang đăng ký">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Registrations", "Admin", new { search = Model.Search, regStatus = Model.RegStatus, paymentStatus = Model.PaymentStatus, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Registrations", "Admin", new { search = Model.Search, regStatus = Model.RegStatus, paymentStatus = Model.PaymentStatus, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Registrations", "Admin", new { search = Model.Search, regStatus = Model.RegStatus, paymentStatus = Model.PaymentStatus, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Không tìm thấy đăng ký.</div>
                </div>
            }
        </div>
    </div>
</div>
