@model LanguageCenter.Models.AdminStudentPageViewModel

@{
    ViewBag.Title = "Manage Students";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="admin-page-header mb-4">
        <div>
            <h2 class="fw-bold mb-1">Manage Students</h2>
            <p class="text-muted mb-0">Create, update, and deactivate student accounts.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Students", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-lg-5 col-md-6">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Full name, email, phone number" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select">
                        <option value="All" @(Model.Status == "All" ? "selected" : "")>All</option>
                        <option value="Active" @(Model.Status == "Active" ? "selected" : "")>Active</option>
                        <option value="Inactive" @(Model.Status == "Inactive" ? "selected" : "")>Inactive</option>
                    </select>
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Search</button>
                        <a href="@Url.Action("Students", "Admin")" class="btn btn-outline-secondary">Reset</a>
                        <a href="@Url.Action("CreateStudent", "Admin")" class="btn btn-success">Create</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student ID</th>
                                <th>Avatar</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Date Of Birth</th>
                                <th>Phone</th>
                                <th>Active</th>
                                <th>Registrations</th>
                                <th>Payments</th>
                                <th>Tests</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Students)
                            {
                                var avatar = string.IsNullOrWhiteSpace(item.Avatar)
                                    ? Url.Content("~/Content/Images/default-avatar.png")
                                    : Url.Content(item.Avatar);

                                <tr>
                                    <td>@item.StudentID</td>
                                    <td><img src="@avatar" alt="@item.FullName" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" /></td>
                                    <td class="fw-semibold">@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>@(item.DateOfBirth.HasValue ? item.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "Updating" : item.PhoneNumber)</td>
                                    <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@item.RegistrationCount</td>
                                    <td>@item.PaymentCount</td>
                                    <td>@item.PlacementTestCount</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("EditStudent", "Admin", new { id = item.StudentID })" class="btn btn-sm btn-outline-primary">Edit</a>
                                            <a href="@Url.Action("DeleteStudent", "Admin", new { id = item.StudentID })" class="btn btn-sm btn-outline-danger">Deactivate</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Student pagination">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Students", "Admin", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage - 1 })">Previous</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Students", "Admin", new { search = Model.Search, status = Model.Status, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Students", "Admin", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage + 1 })">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No students found.</div>
                </div>
            }
        </div>
    </div>
</div>
