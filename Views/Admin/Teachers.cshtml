@model LanguageCenter.Models.AdminTeacherPageViewModel

@{
    ViewBag.Title = "Quản lý giáo viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="admin-page-header mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý giáo viên</h2>
            <p class="text-muted mb-0">Thêm, cập nhật và ngừng hoạt động tài khoản giáo viên.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Teachers", "Admin", FormMethod.Get, new { @class = "row g-3 align-items-end admin-filter-form" }))
            {
                <div class="col-lg-5 col-md-6">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Họ tên, email, chuyên môn" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="status" class="form-label">Trạng thái</label>
                    <select id="status" name="status" class="form-select">
                        <option value="All" @(Model.Status == "All" ? "selected" : "")>Tất cả</option>
                        <option value="Active" @(Model.Status == "Active" ? "selected" : "")>Đang hoạt động</option>
                        <option value="Inactive" @(Model.Status == "Inactive" ? "selected" : "")>Ngừng hoạt động</option>
                    </select>
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="admin-filter-actions">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <a href="@Url.Action("Teachers", "Admin")" class="btn btn-outline-secondary">Đặt lại</a>
                        <a href="@Url.Action("CreateTeacher", "Admin")" class="btn btn-success">Thêm mới</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Teachers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã giáo viên</th>
                                <th>Ảnh đại diện</th>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Chuyên môn</th>
                                <th>Hoạt động</th>
                                <th>Lớp</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Teachers)
                            {
                                var avatar = string.IsNullOrWhiteSpace(item.Avatar)
                                    ? Url.Content("~/Content/Images/default-avatar.png")
                                    : Url.Content(item.Avatar);

                                <tr>
                                    <td>@item.TeacherID</td>
                                    <td><img src="@avatar" alt="@item.FullName" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" /></td>
                                    <td class="fw-semibold">@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Expertise) ? "Đang cập nhật" : item.Expertise)</td>
                                    <td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")</span></td>
                                    <td>@item.ClassCount</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("EditTeacher", "Admin", new { id = item.TeacherID })" class="btn btn-sm btn-outline-primary">Sửa</a>
                                            <a href="@Url.Action("DeleteTeacher", "Admin", new { id = item.TeacherID })" class="btn btn-sm btn-outline-danger">Ngừng hoạt động</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang giáo viên">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Teachers", "Admin", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Teachers", "Admin", new { search = Model.Search, status = Model.Status, page = i })">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Teachers", "Admin", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Không tìm thấy giáo viên.</div>
                </div>
            }
        </div>
    </div>
</div>
