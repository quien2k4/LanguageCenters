@model LanguageCenter.Models.ProgramDetailViewModel

@{
    ViewBag.Title = Model.ProgramName;
    Layout = "~/Views/Shared/_PublicLayout.cshtml";

    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageURL)
        ? Url.Content("~/Content/Images/default-program.jpg")
        : Url.Content(Model.ImageURL);
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-lg-5">
                <img src="@imageUrl" alt="@Model.ProgramName" class="img-fluid rounded shadow-sm w-100" style="max-height: 360px; object-fit: cover;" />
            </div>
            <div class="col-lg-7">
                <h1 class="fw-bold mb-3">@Model.ProgramName</h1>
                <p class="text-muted mb-4">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Mô tả đang được cập nhật." : Model.Description)
                </p>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="bg-white border rounded p-3 h-100">
                            <div class="text-muted small">Trình độ</div>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Level) ? "Đang cập nhật" : Model.Level)</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-white border rounded p-3 h-100">
                            <div class="text-muted small">Thời lượng</div>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Duration) ? "Đang cập nhật" : Model.Duration)</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-white border rounded p-3 h-100">
                            <div class="text-muted small">Học phí</div>
                            <div class="fw-semibold">@Model.Fee.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <h5 class="fw-bold">Chuẩn đầu ra</h5>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.OutputStandard) ? "Chuẩn đầu ra đang được cập nhật." : Model.OutputStandard)</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="fw-bold mb-1">Lớp liên quan</h2>
                <p class="text-muted mb-0">Các lớp đang thuộc chương trình này.</p>
            </div>
            <a href="@Url.Action("Index", "Program")" class="btn btn-outline-secondary">Quay lại chương trình</a>
        </div>

        @if (Model.RelatedClasses.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tên lớp</th>
                            <th>Giáo viên</th>
                            <th>Trạng thái</th>
                            <th>Ngày bắt đầu</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RelatedClasses)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ClassName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.TeacherName) ? "Đang cập nhật" : item.TeacherName)</td>
                                <td>@LanguageCenter.Models.DisplayText.Status(item.StatusName)</td>
                                <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</td>
                                <td class="text-end">
                                    @if (Session["AccountID"] == null)
                                    {
                                        <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-sm">Đăng ký</a>
                                    }
                                    else if (Model.CurrentRole == "Student")
                                    {
                                        <a href="@Url.Action("RegisterClass", "Student", new { classId = item.ClassID })" class="btn btn-primary btn-sm">Đăng ký</a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Không khả dụng</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">Chưa có lớp học cho chương trình này.</div>
        }

        @if (Session["AccountID"] != null && (Model.CurrentRole == "Admin" || Model.CurrentRole == "Teacher"))
        {
            <div class="alert alert-warning mt-4 mb-0">
                Tài khoản quản trị và giáo viên không thể đăng ký lớp học.
            </div>
        }
    </div>
</section>
