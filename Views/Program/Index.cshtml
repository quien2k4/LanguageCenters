@model LanguageCenter.Models.ProgramListViewModel

@{
    ViewBag.Title = "Chương trình";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="bg-light py-5">
    <div class="container">
        <div class="row align-items-end g-3">
            <div class="col-lg-7">
                <h1 class="fw-bold mb-2">Chương trình</h1>
                <p class="text-muted mb-0">Tìm chương trình ngoại ngữ phù hợp với mục tiêu của bạn.</p>
            </div>
            <div class="col-lg-5">
                @using (Html.BeginForm("Index", "Program", FormMethod.Get, new { @class = "row g-2" }))
                {
                    <div class="col-md-5">
                        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Tìm chương trình" />
                    </div>
                    <div class="col-md-4">
                        <select name="level" class="form-select">
                            <option value="">Tất cả trình độ</option>
                            @foreach (var item in Model.Levels)
                            {
                                <option value="@item" @(Model.Level == item ? "selected" : "")>@item</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (Model.Programs.Any())
        {
            <div class="row g-4">
                @foreach (var program in Model.Programs)
                {
                    var imageUrl = string.IsNullOrWhiteSpace(program.ImageURL)
                        ? Url.Content("~/Content/Images/default-program.jpg")
                        : Url.Content(program.ImageURL);

                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0">
                            <img src="@imageUrl" class="card-img-top" alt="@program.ProgramName" style="height: 210px; object-fit: cover;" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@program.ProgramName</h5>
                                <p class="mb-1"><strong>Trình độ:</strong> @(string.IsNullOrWhiteSpace(program.Level) ? "Đang cập nhật" : program.Level)</p>
                                <p class="mb-1"><strong>Thời lượng:</strong> @(string.IsNullOrWhiteSpace(program.Duration) ? "Đang cập nhật" : program.Duration)</p>
                                <p class="mb-3"><strong>Học phí:</strong> @program.Fee.ToString("N0")</p>
                                <a href="@Url.Action("Detail", "Program", new { id = program.ProgramID })" class="btn btn-outline-primary mt-auto">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            if (Model.TotalPages > 1)
            {
                    <nav class="mt-5" aria-label="Phân trang chương trình">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Program", new { search = Model.Search, level = Model.Level, page = Model.CurrentPage - 1 })">Trước</a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Program", new { search = Model.Search, level = Model.Level, page = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Program", new { search = Model.Search, level = Model.Level, page = Model.CurrentPage + 1 })">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info mb-0">Không tìm thấy chương trình.</div>
        }
    </div>
</section>
