@{
    var avatar = Session["Avatar"] == null || string.IsNullOrEmpty(Session["Avatar"].ToString())
        ? Url.Content("~/Content/Images/default-avatar.png")
        : Url.Content(Session["Avatar"].ToString());
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/dashboard.css" rel="stylesheet" />
</head>
<body>

    <div class="dashboard-wrapper">

        <aside class="sidebar admin-sidebar">
            <div class="sidebar-logo">
                Admin Panel
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a href="@Url.Action("Dashboard", "Admin")">Dashboard</a>
                </li>              
                <li>
                    <a href="@Url.Action("Programs", "Admin")">Manage Programs</a>
                </li>
                <li>
                    <a href="@Url.Action("Classes", "Admin")">Manage Classes</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminTeacher")">Manage Teachers</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminStudent")">Manage Students</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminRegistration")">Manage Registrations</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminPayment")">Manage Payments</a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminPlacementTest")">Manage Placement Tests</a>
                </li>
                <li>
                    <a href="@Url.Action("Logout", "Account")">Logout</a>
                </li>
            </ul>
        </aside>

        <div class="main-area">

            <header class="topbar">
                <h4>@ViewBag.Title</h4>

                <div class="user-box">
                    <img src="@avatar" class="avatar-small" />
                    <span>@Session["FullName"]</span>
                </div>
            </header>

            <section class="content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()
            </section>

        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>