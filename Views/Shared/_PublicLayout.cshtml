<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Trung tâm Ngoại ngữ</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/public.css" rel="stylesheet" />
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="@Url.Action("Index", "Home")">
                Trung tâm Ngoại ngữ
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Program")">Chương trình</a>
                    </li>

                    @if (Session["AccountID"] == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-primary ms-lg-2" href="@Url.Action("Register", "Account")">
                                Đăng ký
                            </a>
                        </li>
                    }
                    else
                    {
                        var role = Session["Role"] == null ? string.Empty : Session["Role"].ToString().Trim();

                        if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="btn btn-success public-dashboard-link ms-lg-2" href="@Url.Action("Dashboard", "Admin")">
                                    Bảng điều khiển quản trị
                                </a>
                            </li>
                        }
                        else if (role == "Teacher")
                        {
                            <li class="nav-item">
                                <a class="btn btn-success public-dashboard-link ms-lg-2" href="@Url.Action("Dashboard", "Teacher")">
                                    Bảng điều khiển giáo viên
                                </a>
                            </li>
                        }
                        else if (role == "Student")
                        {
                            <li class="nav-item">
                                <a class="btn btn-success public-dashboard-link ms-lg-2" href="@Url.Action("Profile", "Student")">
                                    Hồ sơ của tôi
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" href="#">Xin chào, @Session["FullName"]</a>
                        </li>

                        <li class="nav-item">
                            <a class="btn btn-outline-danger ms-lg-2" href="@Url.Action("Logout", "Account")">
                                Đăng xuất
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->

    <div class="footer">
        <div class="container">
            <div class="row">
                <div class="footer-col-1">
                    <h3>Download Our App</h3>
                    <p>Download App for Android mobile phone.</p>
                    <div class="app-logo">
                        <img src="~/Content/Images/play-store.png" alt="">
                        <img src="./Content/images/app-store.png" alt="">
                    </div>
                </div>

                <div class="footer-col-2">
                    <img src="./Content/images/logo1.png" alt="">
                    <p>Our Purpose Is to Sustainably Make the Pleasure and Benefits of Sports Accessible to the Many</p>
                </div>

                <div class="footer-col-3">
                    <h3>Team_08</h3>
                    <ul>
                        <li>Nguyễn Tấn Quyền</li>
                        <li>Châu Trí Kiện</li>
                        <li>Lê Thành Đạt</li>                        
                    </ul>
                </div>

                <div class="footer-col-4">
                    <h3>Follow us</h3>
                    <ul>
                        <li>Facebook</li>
                        <li>Twitter</li>
                        <li>Instagram</li>
                        <li>Youtube</li>
                    </ul>
                </div>
            </div>
            <hr>
            <p class="copyright">Language Center.</p>
        </div>
    </div>

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
