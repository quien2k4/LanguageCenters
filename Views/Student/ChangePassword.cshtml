@model LanguageCenter.Models.ChangePasswordViewModel

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Đổi mật khẩu</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("ChangePassword", "Student", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(model => model.CurrentPassword, "Mật khẩu hiện tại", new { @class = "form-label" })
                            @Html.PasswordFor(model => model.CurrentPassword, new { @class = "form-control", autocomplete = "current-password", required = "required" })
                            @Html.ValidationMessageFor(model => model.CurrentPassword, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.NewPassword, "Mật khẩu mới", new { @class = "form-label" })
                            @Html.PasswordFor(model => model.NewPassword, new { @class = "form-control", autocomplete = "new-password", required = "required" })
                            <div class="form-text">Mật khẩu phải có ít nhất 6 ký tự, gồm chữ và số.</div>
                            @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label" })
                            @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", required = "required" })
                            @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Đổi mật khẩu</button>
                            <a href="@Url.Action("Profile", "Student")" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


