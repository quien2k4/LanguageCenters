@model LanguageCenter.Models.StudentConsultationsViewModel

@{
    ViewBag.Title = "Consultation";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Consultation Requests</h2>
            <p class="text-muted mb-0">Your questions and consultation request status.</p>
        </div>
        <a href="@Url.Action("CreateConsultation", "Student")" class="btn btn-primary">Send Consultation Request</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Consultations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Consultation ID</th>
                                <th>Guest Name</th>
                                <th>Contact Information</th>
                                <th>Question Content</th>
                                <th>Request Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Consultations)
                            {
                                <tr>
                                    <td>@item.ConsultationID</td>
                                    <td>@item.GuestName</td>
                                    <td>@item.ContactInformation</td>
                                    <td style="min-width: 260px;">@item.QuestionContent</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @(string.IsNullOrWhiteSpace(item.RequestStatus) ? "Pending" : item.RequestStatus)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">You have not sent any consultation requests yet.</div>
                </div>
            }
        </div>
    </div>
</div>
