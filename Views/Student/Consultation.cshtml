@model LanguageCenter.Models.StudentConsultationsViewModel

@{
    ViewBag.Title = "Tư vấn";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Yêu cầu tư vấn</h2>
            <p class="text-muted mb-0">Câu hỏi và trạng thái yêu cầu tư vấn của bạn.</p>
        </div>
        <a href="@Url.Action("CreateConsultation", "Student")" class="btn btn-primary">Gửi yêu cầu tư vấn</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Consultations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã tư vấn</th>
                                <th>Lớp liên quan</th>
                                <th>Họ tên</th>
                                <th>Thông tin liên hệ</th>
                                <th>Nội dung câu hỏi</th>
                                <th>Trạng thái yêu cầu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Consultations)
                            {
                                <tr>
                                    <td>@item.ConsultationID</td>
                                    <td>
                                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.ClassName) ? "Chưa liên kết lớp" : item.ClassName)</div>
                                        <div class="text-muted small">@(string.IsNullOrWhiteSpace(item.ProgramName) ? "" : item.ProgramName)</div>
                                    </td>
                                    <td>@item.GuestName</td>
                                    <td>@item.ContactInformation</td>
                                    <td style="min-width: 260px;">@item.QuestionContent</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @LanguageCenter.Models.DisplayText.Status(string.IsNullOrWhiteSpace(item.RequestStatus) ? "Pending" : item.RequestStatus)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Bạn chưa gửi yêu cầu tư vấn nào.</div>
                </div>
            }
        </div>
    </div>
</div>
