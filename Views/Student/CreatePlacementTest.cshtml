@model LanguageCenter.Models.CreatePlacementTestViewModel

@{
    ViewBag.Title = "Register Placement Test";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Register Placement Test</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    @using (Html.BeginForm("CreatePlacementTest", "Student", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TestDate, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.TestDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
                            @Html.ValidationMessageFor(model => model.TestDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TestTime, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.TestTime, new { @class = "form-control", type = "time", required = "required" })
                            @Html.ValidationMessageFor(model => model.TestTime, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.Level, new { @class = "form-label" })
                            @Html.DropDownListFor(
                                model => model.Level,
                                new SelectList(new[] { "Beginner", "Elementary", "Intermediate", "Upper Intermediate", "Advanced" }),
                                "Select level",
                                new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(model => model.Level, "", new { @class = "text-danger" })
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-primary">Register Placement Test</button>
                            <a href="@Url.Action("PlacementTests", "Student")" class="btn btn-outline-secondary">Back to Placement Tests</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
