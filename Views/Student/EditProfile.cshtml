@model LanguageCenter.Models.EditStudentProfileViewModel

@{
    ViewBag.Title = "Cập nhật hồ sơ";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var avatar = string.IsNullOrWhiteSpace(Model.Avatar)
        ? Url.Content("~/Content/Images/default-avatar.png")
        : Url.Content(Model.Avatar);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Cập nhật hồ sơ</h4>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <img src="@avatar" alt="@Model.FullName" class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;" />
                        <div>
                            <div class="fw-semibold">@Model.FullName</div>
                            <div class="text-muted">@Model.Email</div>
                        </div>
                    </div>

                    @using (Html.BeginForm("EditProfile", "Student", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.StudentID)
                        @Html.HiddenFor(model => model.Email)
                        @Html.HiddenFor(model => model.Avatar)

                        <div class="row g-3">
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.FullName, "Họ tên", new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.FullName, new { @class = "form-control", required = "required" })
                                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.DateOfBirth, "Ngày sinh", new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                                @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.PhoneNumber, "Số điện thoại", new { @class = "form-label" })
                                @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control", type = "tel", required = "required" })
                                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-6">
                                <label for="avatarFile" class="form-label">Ảnh đại diện</label>
                                <input type="file" id="avatarFile" name="avatarFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                            <a href="@Url.Action("Profile", "Student")" class="btn btn-outline-secondary">Quay lại</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

