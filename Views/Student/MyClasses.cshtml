@model LanguageCenter.Models.StudentMyClassesViewModel

@{
    ViewBag.Title = "Lớp học của tôi";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lớp học của tôi</h2>
            <p class="text-muted mb-0">Các lớp bạn đã đăng ký.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Payments", "Student")" class="btn btn-outline-primary">Xem thanh toán</a>
            <a href="@Url.Action("Index", "Program")" class="btn btn-primary">Quay lại chương trình</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đăng ký</th>
                                <th>Lớp</th>
                                <th>Chương trình</th>
                                <th>Giáo viên</th>
                                <th>Trạng thái lớp</th>
                                <th>Ngày bắt đầu</th>
                                <th>Lịch học</th>
                                <th>Phòng</th>
                                <th>Ngày đăng ký</th>
                                <th>Trạng thái đăng ký</th>
                                <th>Số tiền</th>
                                <th>Trạng thái thanh toán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Classes)
                            {
                                <tr>
                                    <td>@item.RegistrationID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Đang cập nhật" : item.ProgramName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.TeacherName) ? "Đang cập nhật" : item.TeacherName)</td>
                                    <td>@LanguageCenter.Models.DisplayText.Status(item.ClassStatus)</td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</td>
                                    <td style="min-width: 220px;">@item.Schedule</td>
                                    <td>@item.Room</td>
                                    <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@LanguageCenter.Models.DisplayText.Status(item.RegStatus)</span>
                                    </td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>
                                        <span class="badge @(item.PaymentStatus == "Unpaid" ? "bg-warning text-dark" : "bg-success")">
                                            @LanguageCenter.Models.DisplayText.Status(item.PaymentStatus)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Bạn chưa đăng ký lớp học nào.</div>
                </div>
            }
        </div>
    </div>
</div>
