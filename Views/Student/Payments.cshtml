@model LanguageCenter.Models.StudentPaymentsViewModel

@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@functions {
    private static string RegistrationStatusText(string value)
    {
        switch ((value ?? string.Empty).Trim())
        {
            case "Pending":
                return "Chờ mở lớp";
            default:
                return LanguageCenter.Models.DisplayText.Status(value);
        }
    }
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Thanh toán</h2>
            <p class="text-muted mb-0">Quản lý các khoản thanh toán lớp học của bạn.</p>
        </div>
        <a href="@Url.Action("MyClasses", "Student")" class="btn btn-outline-primary">Quay lại lớp học của tôi</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Payments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã thanh toán</th>
                                <th>Mã đăng ký</th>
                                <th>Lớp</th>
                                <th>Chương trình</th>
                                <th>Số tiền</th>
                                <th>Ngày thanh toán</th>
                                <th>Phương thức</th>
                                <th>Trạng thái thanh toán</th>
                                <th>Trạng thái đăng ký</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Payments)
                            {
                                var isPaid = item.PaymentStatus == "Paid";
                                var isUnpaid = item.PaymentStatus == "Unpaid";

                                <tr>
                                    <td>@item.PaymentID</td>
                                    <td>@item.RegistrationID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Đang cập nhật" : item.ProgramName)</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Method) ? "Chưa chọn" : item.Method)</td>
                                    <td>
                                        @if (isPaid)
                                        {
                                            <span class="badge bg-success">Đã thanh toán</span>
                                        }
                                        else if (isUnpaid)
                                        {
                                            <span class="badge bg-warning text-dark">Chưa thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@LanguageCenter.Models.DisplayText.Status(item.PaymentStatus)</span>
                                        }
                                    </td>
                                    <td>@RegistrationStatusText(item.RegistrationStatus)</td>
                                    <td class="text-end">
                                        @if (isUnpaid)
                                        {
                                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                                @using (Html.BeginForm("PayDemo", "Student", new { paymentId = item.PaymentID }, FormMethod.Post))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-primary btn-sm">Thanh toán thử</button>
                                                }

                                                <a href="@Url.Action("VnPayCheckout", "Payment", new { paymentId = item.PaymentID })" class="btn btn-success btn-sm">
                                                    Thanh toán VNPAY
                                                </a>
                                            </div>
                                        }
                                        else if (isPaid)
                                        {
                                            <span class="badge bg-success">Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có thao tác</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Bạn chưa có khoản thanh toán nào.</div>
                </div>
            }
        </div>
    </div>
</div>
