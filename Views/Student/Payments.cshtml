@model LanguageCenter.Models.StudentPaymentsViewModel

@{
    ViewBag.Title = "Payments";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Payments</h2>
            <p class="text-muted mb-0">Manage your class payment records.</p>
        </div>
        <a href="@Url.Action("MyClasses", "Student")" class="btn btn-outline-primary">Back to My Classes</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Payments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Payment ID</th>
                                <th>Registration ID</th>
                                <th>Class</th>
                                <th>Program</th>
                                <th>Amount</th>
                                <th>Payment Date</th>
                                <th>Method</th>
                                <th>Payment Status</th>
                                <th>Registration Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Payments)
                            {
                                var isPaid = item.PaymentStatus == "Paid";
                                var isUnpaid = item.PaymentStatus == "Unpaid";

                                <tr>
                                    <td>@item.PaymentID</td>
                                    <td>@item.RegistrationID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Updating" : item.ProgramName)</td>
                                    <td>@item.Amount.ToString("N0")</td>
                                    <td>@(item.PaymentDate.HasValue ? item.PaymentDate.Value.ToString("dd/MM/yyyy HH:mm") : "Updating")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Method) ? "Not selected" : item.Method)</td>
                                    <td>
                                        @if (isPaid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (isUnpaid)
                                        {
                                            <span class="badge bg-warning text-dark">Unpaid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "Updating" : item.PaymentStatus)</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.RegistrationStatus) ? "Updating" : item.RegistrationStatus)</td>
                                    <td class="text-end">
                                        @if (isUnpaid)
                                        {
                                            using (Html.BeginForm("PayDemo", "Student", new { paymentId = item.PaymentID }, FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-primary btn-sm">Pay Demo</button>
                                            }
                                        }
                                        else if (isPaid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No action</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">You do not have any payments yet.</div>
                </div>
            }
        </div>
    </div>
</div>
