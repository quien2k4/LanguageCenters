@model LanguageCenter.Models.StudentPlacementTestsViewModel

@{
    ViewBag.Title = "Placement Tests";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Placement Tests</h2>
            <p class="text-muted mb-0">Your registered placement test schedule and results.</p>
        </div>
        <a href="@Url.Action("CreatePlacementTest", "Student")" class="btn btn-primary">Register Placement Test</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.PlacementTests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Test ID</th>
                                <th>Test Date</th>
                                <th>Test Time</th>
                                <th>Level</th>
                                <th>Result Score</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PlacementTests)
                            {
                                <tr>
                                    <td>@item.TestID</td>
                                    <td>@item.TestDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.TestTime.ToString(@"hh\:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Level) ? "Updating" : item.Level)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ResultScore) ? "Not updated yet" : item.ResultScore)</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@(string.IsNullOrWhiteSpace(item.Status) ? "Pending" : item.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">You have not registered for any placement tests yet.</div>
                </div>
            }
        </div>
    </div>
</div>
