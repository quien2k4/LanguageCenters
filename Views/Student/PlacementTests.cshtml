@model LanguageCenter.Models.StudentPlacementTestsViewModel

@{
    ViewBag.Title = "Kiểm tra đầu vào";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Kiểm tra đầu vào</h2>
            <p class="text-muted mb-0">Lịch kiểm tra đầu vào và kết quả của bạn.</p>
        </div>
        <a href="@Url.Action("CreatePlacementTest", "Student")" class="btn btn-primary">Đăng ký kiểm tra đầu vào</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.PlacementTests.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã bài kiểm tra</th>
                                <th>Ngày kiểm tra</th>
                                <th>Giờ kiểm tra</th>
                                <th>Trình độ</th>
                                <th>Điểm kết quả</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PlacementTests)
                            {
                                <tr>
                                    <td>@item.TestID</td>
                                    <td>@item.TestDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.TestTime.ToString(@"hh\:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Level) ? "Đang cập nhật" : item.Level)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ResultScore) ? "Chưa cập nhật" : item.ResultScore)</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@LanguageCenter.Models.DisplayText.Status(string.IsNullOrWhiteSpace(item.Status) ? "Pending" : item.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Bạn chưa đăng ký bài kiểm tra đầu vào nào.</div>
                </div>
            }
        </div>
    </div>
</div>
