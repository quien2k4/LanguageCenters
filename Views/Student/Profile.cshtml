@model LanguageCenter.Models.StudentProfileViewModel

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var avatar = string.IsNullOrWhiteSpace(Model.Avatar)
        ? Url.Content("~/Content/Images/default-avatar.png")
        : Url.Content(Model.Avatar);
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h4 class="mb-0">Hồ sơ cá nhân</h4>
            <div class="d-flex gap-2">
                <a href="@Url.Action("EditProfile", "Student")" class="btn btn-light btn-sm">Cập nhật hồ sơ</a>
                <a href="@Url.Action("ChangePassword", "Student")" class="btn btn-outline-light btn-sm">Đổi mật khẩu</a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-md-3 text-center">
                    <img src="@avatar" alt="@Model.FullName" class="rounded-circle shadow-sm mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                    <div class="fw-semibold">@Model.FullName</div>
                    <div class="text-muted small">Học viên</div>
                </div>
                <div class="col-md-9">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Email</div>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Họ tên</div>
                                <div class="fw-semibold">@Model.FullName</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Ngày sinh</div>
                                <div class="fw-semibold">@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Số điện thoại</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

