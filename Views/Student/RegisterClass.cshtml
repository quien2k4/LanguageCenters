@model LanguageCenter.Models.StudentRegisterClassViewModel

@{
    ViewBag.Title = "Register Class";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Confirm Class Registration</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-warning">@TempData["Error"]</div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <h5 class="fw-bold mb-3">@Model.ClassName</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Program</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Updating" : Model.ProgramName)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Teacher</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.TeacherName) ? "Updating" : Model.TeacherName)</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Status</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.StatusName) ? "Updating" : Model.StatusName)</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Start Date</div>
                                <div class="fw-semibold">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Fee</div>
                                <div class="fw-semibold">@Model.Fee.ToString("N0")</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.IsAlreadyRegistered)
                    {
                        <div class="alert alert-warning">You already registered this class.</div>
                    }

                    <div class="d-flex flex-wrap gap-2">
                        @using (Html.BeginForm("RegisterClassConfirm", "Student", new { classId = Model.ClassID }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary" @(Model.IsAlreadyRegistered ? "disabled" : "")>
                                Confirm Register
                            </button>
                        }

                        @if (Model.ProgramID > 0)
                        {
                            <a href="@Url.Action("Detail", "Program", new { id = Model.ProgramID })" class="btn btn-outline-secondary">Back to Program Detail</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Program")" class="btn btn-outline-secondary">Back to Programs</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
