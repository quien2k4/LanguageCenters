@model LanguageCenter.Models.StudentRegisterClassViewModel

@{
    ViewBag.Title = "Đăng ký lớp";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Xác nhận đăng ký lớp</h4>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-warning">@TempData["Error"]</div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <h5 class="fw-bold mb-3">@Model.ClassName</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Chương trình</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Đang cập nhật" : Model.ProgramName)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Giáo viên</div>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.TeacherName) ? "Đang cập nhật" : Model.TeacherName)</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Trạng thái</div>
                                <div class="fw-semibold">@LanguageCenter.Models.DisplayText.Status(Model.StatusName)</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Ngày bắt đầu</div>
                                <div class="fw-semibold">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Học phí</div>
                                <div class="fw-semibold">@Model.Fee.ToString("N0")</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.IsAlreadyRegistered)
                    {
                        <div class="alert alert-warning">Bạn đã đăng ký lớp này.</div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            Bạn có thể đăng ký lớp này ngay cả khi lớp sắp khai giảng hoặc đang chờ đủ học viên. Sau khi đăng ký, trạng thái của bạn sẽ là <strong>Chờ mở lớp</strong>.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2">
                        @using (Html.BeginForm("RegisterClassConfirm", "Student", new { classId = Model.ClassID }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary" @(Model.IsAlreadyRegistered ? "disabled" : "")>
                                Xác nhận đăng ký
                            </button>
                        }

                        @if (Model.ProgramID > 0)
                        {
                            <a href="@Url.Action("Detail", "Program", new { id = Model.ProgramID })" class="btn btn-outline-secondary">Quay lại chi tiết chương trình</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "Program")" class="btn btn-outline-secondary">Quay lại chương trình</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
