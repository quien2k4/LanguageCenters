@model LanguageCenter.Models.TeacherClassAttendanceViewModel

@{
    ViewBag.Title = "Điểm danh lớp học";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

@functions {
    private static string AttendanceText(string value)
    {
        return LanguageCenter.Helpers.AttendanceDisplayHelper.Text(value);
    }

    private static string AttendanceBadgeClass(string value)
    {
        return LanguageCenter.Helpers.AttendanceDisplayHelper.BadgeClass(value);
    }
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Điểm danh lớp học</h2>
            <p class="text-muted mb-0">Cập nhật trạng thái tham gia của học viên theo từng buổi học.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("ClassStudents", "Teacher", new { classId = Model.ClassID })" class="btn btn-outline-primary">Danh sách học viên</a>
            <a href="@Url.Action("MyClasses", "Teacher")" class="btn btn-outline-secondary">Quay lại lớp của tôi</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">@Model.ClassName</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Chương trình</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Đang cập nhật" : Model.ProgramName)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Giáo viên</div>
                        <div class="fw-semibold">@Model.TeacherName</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Phòng</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.RoomText) ? "Chưa có phòng" : Model.RoomText)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Tiến độ học tập</div>
                        <div class="fw-semibold mb-2">@Model.ProgressText</div>
                        <div class="progress" style="height: 7px;">
                            <div class="progress-bar bg-success" style="width: @(Model.ProgressPercent)%"></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Lịch học</div>
                        <div style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.ScheduleText) ? "Chưa có lịch học" : Model.ScheduleText)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("ClassAttendance", "Teacher", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ClassID)

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Ngày học</label>
                        <input type="date" name="SelectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control" />
                    </div>
                    <div class="col-md-8 text-md-end">
                        <button type="submit" class="btn btn-success">Lưu điểm danh</button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model.Students.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Học viên</th>
                                    <th>Email</th>
                                    <th>Số điện thoại</th>
                                    <th>Trạng thái đăng ký</th>
                                    <th>Trạng thái hiện tại</th>
                                    <th style="min-width: 180px;">Điểm danh</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Students.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Html.HiddenFor(m => m.Students[i].RegistrationID)
                                            @Html.HiddenFor(m => m.Students[i].StudentID)
                                            <span class="fw-semibold">@Model.Students[i].StudentName</span>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(Model.Students[i].Email) ? "Đang cập nhật" : Model.Students[i].Email)</td>
                                        <td>@(string.IsNullOrWhiteSpace(Model.Students[i].PhoneNumber) ? "Đang cập nhật" : Model.Students[i].PhoneNumber)</td>
                                        <td>@LanguageCenter.Models.DisplayText.Status(Model.Students[i].RegStatus)</td>
                                        <td><span class="badge @AttendanceBadgeClass(Model.Students[i].AttendanceStatus)">@AttendanceText(Model.Students[i].AttendanceStatus)</span></td>
                                        <td>
                                            <select name="Students[@i].AttendanceStatus" class="form-select form-select-sm">
                                                <option value="Present" @(Model.Students[i].AttendanceStatus == "Present" ? "selected" : "")>Có mặt</option>
                                                <option value="Absent" @(Model.Students[i].AttendanceStatus == "Absent" ? "selected" : "")>Vắng</option>
                                                <option value="Excused" @(Model.Students[i].AttendanceStatus == "Excused" ? "selected" : "")>Vắng có phép</option>
                                            </select>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4">
                        <div class="alert alert-info mb-0">Chưa có học viên đăng ký lớp này.</div>
                    </div>
                }
            </div>
        </div>
    }
</div>
