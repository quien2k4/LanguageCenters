@model LanguageCenter.Models.TeacherClassStudentsViewModel

@{
    ViewBag.Title = "Class Students";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Class Students</h2>
            <p class="text-muted mb-0">Students registered in this class.</p>
        </div>
        <a href="@Url.Action("MyClasses", "Teacher")" class="btn btn-outline-primary">Back to My Classes</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.ClassName</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Class ID</div>
                        <div class="fw-semibold">@Model.ClassID</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Program</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Updating" : Model.ProgramName)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Start Date</div>
                        <div class="fw-semibold">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Class Status</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ClassStatus) ? "Updating" : Model.ClassStatus)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student ID</th>
                                <th>Student Name</th>
                                <th>Phone Number</th>
                                <th>Registration Date</th>
                                <th>Registration Status</th>
                                <th>Payment Status</th>
                                <th>Latest Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Students)
                            {
                                <tr>
                                    <td>@item.StudentID</td>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.StudentName) ? "Unknown student" : item.StudentName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "Updating" : item.PhoneNumber)</td>
                                    <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Updating")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@(string.IsNullOrWhiteSpace(item.RegistrationStatus) ? "Updating" : item.RegistrationStatus)</span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.PaymentStatus == "Paid" ? "bg-success" : item.PaymentStatus == "Unpaid" ? "bg-warning text-dark" : "bg-secondary")">
                                            @(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "No payment" : item.PaymentStatus)
                                        </span>
                                    </td>
                                    <td>@item.LatestAttendanceStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No students registered in this class yet.</div>
                </div>
            }
        </div>
    </div>
</div>
