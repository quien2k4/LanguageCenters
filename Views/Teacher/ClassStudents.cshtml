@model LanguageCenter.Models.TeacherClassStudentsViewModel

@{
    ViewBag.Title = "Học viên trong lớp";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Học viên trong lớp</h2>
            <p class="text-muted mb-0">Danh sách học viên đã đăng ký lớp này.</p>
        </div>
        <a href="@Url.Action("MyClasses", "Teacher")" class="btn btn-outline-primary">Quay lại lớp của tôi</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.ClassName</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Mã lớp</div>
                        <div class="fw-semibold">@Model.ClassID</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Chương trình</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Đang cập nhật" : Model.ProgramName)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Ngày bắt đầu</div>
                        <div class="fw-semibold">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Trạng thái lớp</div>
                        <div class="fw-semibold">@LanguageCenter.Models.DisplayText.Status(Model.ClassStatus)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã học viên</th>
                                <th>Tên học viên</th>
                                <th>Số điện thoại</th>
                                <th>Ngày đăng ký</th>
                                <th>Trạng thái đăng ký</th>
                                <th>Trạng thái thanh toán</th>
                                <th>Điểm danh gần nhất</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Students)
                            {
                                <tr>
                                    <td>@item.StudentID</td>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.StudentName) ? "Học viên chưa xác định" : item.StudentName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "Đang cập nhật" : item.PhoneNumber)</td>
                                    <td>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@LanguageCenter.Models.DisplayText.Status(item.RegistrationStatus)</span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.PaymentStatus == "Paid" ? "bg-success" : item.PaymentStatus == "Unpaid" ? "bg-warning text-dark" : "bg-secondary")">
                                            @LanguageCenter.Models.DisplayText.Status(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "No payment" : item.PaymentStatus)
                                        </span>
                                    </td>
                                    <td>@item.LatestAttendanceStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Chưa có học viên đăng ký lớp này.</div>
                </div>
            }
        </div>
    </div>
</div>
