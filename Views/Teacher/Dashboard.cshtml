@model LanguageCenter.Models.TeacherDashboardViewModel

@{
    ViewBag.Title = "Teacher Dashboard";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Teacher Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome, @Model.FullName
                @if (!string.IsNullOrWhiteSpace(Model.Expertise))
                {
                    <span> - @Model.Expertise</span>
                }
            </p>
        </div>
        <div class="text-muted small">
            Teacher ID: @Model.TeacherID
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Classes</div>
                    <div class="display-6 fw-bold">@Model.TotalClasses</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Students</div>
                    <div class="display-6 fw-bold">@Model.TotalStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Schedules</div>
                    <div class="display-6 fw-bold">@Model.TotalSchedules</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Recent Registrations</div>
                    <div class="display-6 fw-bold">@Model.RecentRegistrations</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Teaching Schedule</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.TeachingSchedules.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Class</th>
                                        <th>Program</th>
                                        <th>Day</th>
                                        <th>Time</th>
                                        <th>Room</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.TeachingSchedules)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.ClassName</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Updating" : item.ProgramName)</td>
                                            <td>@item.DayOfWeek</td>
                                            <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Room) ? "No room" : item.Room)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="alert alert-info mb-0">No teaching schedule available.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Recent Activities</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        foreach (var item in Model.RecentActivities)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.StudentName) ? "Unknown student" : item.StudentName)</div>
                                <div class="text-muted small">@item.ClassName</div>
                                <div class="d-flex justify-content-between mt-2">
                                    <span>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Updating")</span>
                                    <span class="badge bg-info text-dark">@(string.IsNullOrWhiteSpace(item.RegStatus) ? "Updating" : item.RegStatus)</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">No recent registrations available.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">My Recent Classes</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentClasses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Class</th>
                                <th>Program</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>Student Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentClasses)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Updating" : item.ProgramName)</td>
                                    <td><span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.StatusName) ? "Updating" : item.StatusName)</span></td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                                    <td>@item.StudentCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No classes assigned to you yet.</div>
                </div>
            }
        </div>
    </div>
</div>
