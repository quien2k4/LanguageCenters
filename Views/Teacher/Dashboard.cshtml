@{
    ViewBag.Title = "Teacher Dashboard";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Teacher Dashboard</h4>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">Welcome to the temporary teacher test page.</p>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Full Name</div>
                        <div class="fw-semibold">@ViewBag.FullName</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Role</div>
                        <div class="fw-semibold">@ViewBag.Role</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Account ID</div>
                        <div class="fw-semibold">@ViewBag.AccountID</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
