@model LanguageCenter.Models.TeacherDashboardViewModel

@{
    ViewBag.Title = "Bảng điều khiển giáo viên";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Bảng điều khiển giáo viên</h2>
            <p class="text-muted mb-0">
                Xin chào, @Model.FullName
                @if (!string.IsNullOrWhiteSpace(Model.Expertise))
                {
                    <span> - @Model.Expertise</span>
                }
            </p>
        </div>
        <div class="text-muted small">
            Mã giáo viên: @Model.TeacherID
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng lớp học</div>
                    <div class="display-6 fw-bold">@Model.TotalClasses</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng học viên</div>
                    <div class="display-6 fw-bold">@Model.TotalStudents</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng lịch học</div>
                    <div class="display-6 fw-bold">@Model.TotalSchedules</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Đăng ký gần đây</div>
                    <div class="display-6 fw-bold">@Model.RecentRegistrations</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Lịch giảng dạy</h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.TeachingSchedules.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Lớp</th>
                                        <th>Chương trình</th>
                                        <th>Ngày</th>
                                        <th>Thời gian</th>
                                        <th>Phòng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.TeachingSchedules)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.ClassName</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Đang cập nhật" : item.ProgramName)</td>
                                            <td>@item.DayOfWeek</td>
                                            <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Room) ? "Chưa có phòng" : item.Room)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4">
                            <div class="alert alert-info mb-0">Chưa có lịch giảng dạy.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Hoạt động gần đây</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        foreach (var item in Model.RecentActivities)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.StudentName) ? "Học viên chưa xác định" : item.StudentName)</div>
                                <div class="text-muted small">@item.ClassName</div>
                                <div class="d-flex justify-content-between mt-2">
                                    <span>@(item.RegistrationDate.HasValue ? item.RegistrationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")</span>
                                    <span class="badge bg-info text-dark">@LanguageCenter.Models.DisplayText.Status(item.RegStatus)</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">Chưa có đăng ký gần đây.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Lớp gần đây của tôi</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.RecentClasses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Lớp</th>
                                <th>Chương trình</th>
                                <th>Trạng thái</th>
                                <th>Ngày bắt đầu</th>
                                <th>Số học viên</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentClasses)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Đang cập nhật" : item.ProgramName)</td>
                                    <td><span class="badge bg-secondary">@LanguageCenter.Models.DisplayText.Status(item.StatusName)</span></td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</td>
                                    <td>@item.StudentCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Bạn chưa được phân công lớp nào.</div>
                </div>
            }
        </div>
    </div>
</div>
