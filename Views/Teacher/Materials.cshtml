@model LanguageCenter.Models.TeacherMaterialsViewModel

@{
    ViewBag.Title = "Class Materials";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Class Materials</h2>
            <p class="text-muted mb-0">Upload and manage learning materials for this class.</p>
        </div>
        <a href="@Url.Action("MyClasses", "Teacher")" class="btn btn-outline-primary">Back to My Classes</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.ClassName</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Class ID</div>
                        <div class="fw-semibold">@Model.ClassID</div>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Program</div>
                        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.ProgramName) ? "Updating" : Model.ProgramName)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Upload Material</h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UploadMaterial", "Teacher", new { classId = Model.ClassID }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title" name="title" class="form-control" required="required" />
                    </div>
                    <div class="col-md-5">
                        <label for="file" class="form-label">File</label>
                        <input type="file" id="file" name="file" class="form-control" required="required" accept=".pdf,.doc,.docx,.ppt,.pptx,.txt" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Upload</button>
                    </div>
                </div>
                <div class="form-text mt-2">Allowed files: pdf, doc, docx, ppt, pptx, txt.</div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Uploaded Materials</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Materials.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Material ID</th>
                                <th>Title</th>
                                <th>File Path</th>
                                <th>Upload Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Materials)
                            {
                                <tr>
                                    <td>@item.MaterialID</td>
                                    <td class="fw-semibold">@item.Title</td>
                                    <td>@item.FilePath</td>
                                    <td>@(item.UploadDate.HasValue ? item.UploadDate.Value.ToString("dd/MM/yyyy HH:mm") : "Updating")</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("DownloadMaterial", "Teacher", new { materialId = item.MaterialID })" class="btn btn-sm btn-outline-primary">Download</a>

                                            @using (Html.BeginForm("DeleteMaterial", "Teacher", new { materialId = item.MaterialID }, FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">No materials uploaded yet.</div>
                </div>
            }
        </div>
    </div>
</div>
