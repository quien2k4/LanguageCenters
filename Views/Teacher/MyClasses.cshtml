@model LanguageCenter.Models.TeacherMyClassesViewModel

@{
    ViewBag.Title = "Lớp đang dạy";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Lớp đang dạy</h2>
            <p class="text-muted mb-0">Các lớp được phân công cho tài khoản giáo viên của bạn.</p>
        </div>
        <a href="@Url.Action("Dashboard", "Teacher")" class="btn btn-outline-primary">Quay lại bảng điều khiển</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã lớp</th>
                                <th>Tên lớp</th>
                                <th>Chương trình</th>
                                <th>Ngày bắt đầu</th>
                                <th>Trạng thái</th>
                                <th>Lịch học</th>
                                <th>Phòng</th>
                                <th>Học viên</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Classes)
                            {
                                <tr>
                                    <td>@item.ClassID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Đang cập nhật" : item.ProgramName)</td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Đang cập nhật")</td>
                                    <td>
                                        <span class="badge bg-secondary">@LanguageCenter.Models.DisplayText.Status(item.ClassStatus)</span>
                                    </td>
                                    <td style="min-width: 240px; white-space: pre-line;">@item.Schedule</td>
                                    <td>@item.Room</td>
                                    <td>@item.StudentCount</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("ClassStudents", "Teacher", new { classId = item.ClassID })" class="btn btn-sm btn-outline-primary">Xem học viên</a>
                                            <a href="@Url.Action("Materials", "Teacher", new { classId = item.ClassID })" class="btn btn-sm btn-outline-secondary">Tài liệu</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Bạn chưa có lớp giảng dạy nào.</div>
                </div>
            }
        </div>
    </div>
</div>
