@model LanguageCenter.Models.TeacherMyClassesViewModel

@{
    ViewBag.Title = "My Teaching Classes";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Teaching Classes</h2>
            <p class="text-muted mb-0">Classes assigned to your teacher account.</p>
        </div>
        <a href="@Url.Action("Dashboard", "Teacher")" class="btn btn-outline-primary">Back to Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Class ID</th>
                                <th>Class Name</th>
                                <th>Program</th>
                                <th>Start Date</th>
                                <th>Status</th>
                                <th>Schedule</th>
                                <th>Room</th>
                                <th>Students</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Classes)
                            {
                                <tr>
                                    <td>@item.ClassID</td>
                                    <td class="fw-semibold">@item.ClassName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ProgramName) ? "Updating" : item.ProgramName)</td>
                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd/MM/yyyy") : "Updating")</td>
                                    <td>
                                        <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.ClassStatus) ? "Updating" : item.ClassStatus)</span>
                                    </td>
                                    <td style="min-width: 240px; white-space: pre-line;">@item.Schedule</td>
                                    <td>@item.Room</td>
                                    <td>@item.StudentCount</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="@Url.Action("ClassStudents", "Teacher", new { classId = item.ClassID })" class="btn btn-sm btn-outline-primary">View Students</a>
                                            <a href="@Url.Action("Materials", "Teacher", new { classId = item.ClassID })" class="btn btn-sm btn-outline-secondary">Materials</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">You do not have any teaching classes yet.</div>
                </div>
            }
        </div>
    </div>
</div>
