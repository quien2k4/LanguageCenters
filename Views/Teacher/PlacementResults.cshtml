@model LanguageCenter.Models.TeacherPlacementResultsPageViewModel

@{
    ViewBag.Title = "Kết quả kiểm tra đầu vào";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Kết quả kiểm tra đầu vào</h2>
            <p class="text-muted mb-0">Xem đăng ký và kết quả kiểm tra đầu vào của học viên.</p>
        </div>
        <a href="@Url.Action("Dashboard", "Teacher")" class="btn btn-outline-primary">Quay lại bảng điều khiển</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("PlacementResults", "Teacher", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-5">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tên học viên hoặc trình độ" />
                </div>
                <div class="col-md-4">
                    <label for="status" class="form-label">Trạng thái</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        @foreach (var item in Model.Statuses)
                        {
                            <option value="@item" @(Model.Status == item ? "selected" : "")>@LanguageCenter.Models.DisplayText.Status(item)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Results.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã bài kiểm tra</th>
                                <th>Tên học viên</th>
                                <th>Số điện thoại</th>
                                <th>Ngày kiểm tra</th>
                                <th>Giờ kiểm tra</th>
                                <th>Trình độ</th>
                                <th>Điểm kết quả</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Results)
                            {
                                <tr>
                                    <td>@item.TestID</td>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.StudentName) ? "Học viên chưa xác định" : item.StudentName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "Đang cập nhật" : item.PhoneNumber)</td>
                                    <td>@item.TestDate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.TestTime.ToString(@"hh\:mm")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Level) ? "Đang cập nhật" : item.Level)</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.ResultScore) ? "Chưa cập nhật" : item.ResultScore)</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@LanguageCenter.Models.DisplayText.Status(item.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang kết quả kiểm tra đầu vào">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("PlacementResults", "Teacher", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>

                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("PlacementResults", "Teacher", new { search = Model.Search, status = Model.Status, page = i })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("PlacementResults", "Teacher", new { search = Model.Search, status = Model.Status, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Không tìm thấy kết quả kiểm tra đầu vào.</div>
                </div>
            }
        </div>
    </div>
</div>
