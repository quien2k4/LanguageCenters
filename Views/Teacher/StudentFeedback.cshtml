@model LanguageCenter.Models.TeacherStudentFeedbackPageViewModel

@{
    ViewBag.Title = "Phản hồi học viên";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Phản hồi học viên</h2>
            <p class="text-muted mb-0">Phản hồi được gửi cho các lớp bạn giảng dạy.</p>
        </div>
        <a href="@Url.Action("Dashboard", "Teacher")" class="btn btn-outline-primary">Quay lại bảng điều khiển</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Tổng phản hồi</div>
                    <div class="display-6 fw-bold">@Model.TotalFeedback</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Điểm đánh giá trung bình</div>
                    <div class="display-6 fw-bold">@Model.AverageRating.ToString("0.0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @using (Html.BeginForm("StudentFeedback", "Teacher", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-5">
                    <label for="search" class="form-label">Tìm kiếm</label>
                    <input type="text" id="search" name="search" value="@Model.Search" class="form-control" placeholder="Tên học viên hoặc bình luận" />
                </div>
                <div class="col-md-4">
                    <label for="rating" class="form-label">Đánh giá</label>
                    <select id="rating" name="rating" class="form-select">
                        <option value="">Tất cả đánh giá</option>
                        @foreach (var item in Model.Ratings)
                        {
                            <option value="@item" @(Model.Rating == item ? "selected" : "")>@item</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Feedbacks.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã phản hồi</th>
                                <th>Tên học viên</th>
                                <th>Đánh giá</th>
                                <th>Bình luận</th>
                                <th>Ngày phản hồi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Feedbacks)
                            {
                                <tr>
                                    <td>@item.FeedbackID</td>
                                    <td class="fw-semibold">@(string.IsNullOrWhiteSpace(item.StudentName) ? "Học viên chưa xác định" : item.StudentName)</td>
                                    <td>
                                        @if (item.Rating.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark">@item.Rating</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa đánh giá</span>
                                        }
                                    </td>
                                    <td style="min-width: 280px;">@(string.IsNullOrWhiteSpace(item.Comment) ? "Không có bình luận" : item.Comment)</td>
                                    <td>@(item.FeedbackDate.HasValue ? item.FeedbackDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đang cập nhật")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                if (Model.TotalPages > 1)
                {
                    <nav class="p-3" aria-label="Phân trang phản hồi học viên">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("StudentFeedback", "Teacher", new { search = Model.Search, rating = Model.Rating, page = Model.CurrentPage - 1 })">Trước</a>
                            </li>

                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("StudentFeedback", "Teacher", new { search = Model.Search, rating = Model.Rating, page = i })">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("StudentFeedback", "Teacher", new { search = Model.Search, rating = Model.Rating, page = Model.CurrentPage + 1 })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="p-4">
                    <div class="alert alert-info mb-0">Chưa có phản hồi của học viên.</div>
                </div>
            }
        </div>
    </div>
</div>
